# Copy to .env and fill in. Leave DATABASE_URL unset to use the in-memory store.
#
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the direct connection (port 5432) for a long-running server.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Any other Postgres works too, as does SQLite for local persistence:
# DATABASE_URL=sqlite:///./notes.db
